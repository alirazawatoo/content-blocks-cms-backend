{
  "kind": "collectionType",
  "collectionName": "content_pages",
  "info": {
    "singularName": "content-page",
    "pluralName": "content-pages",
    "displayName": "Content Page",
    "description": "A standalone editorial page addressed by its slug."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "content": {
      "type": "richtext"
    }
  }
}
