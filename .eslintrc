{
  "root": true,
  "extends": "eslint:recommended",
  "env": {
    "commonjs": true,
    "es2021": true,
    "node": true,
    "jest": true,
    "browser": false
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "globals": {
    "strapi": "readonly"
  },
  "rules": {
    "indent": ["error", 2, { "SwitchCase": 1 }],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single", { "allowTemplateLiterals": false }],
    "semi": ["error", "always"],
    "no-console": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "eqeqeq": ["error", "smart"],
    "prefer-const": "error",
    "no-var": "error"
  }
}
