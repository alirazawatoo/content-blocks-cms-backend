# Copy to `.env` (git-ignored) and fill in the blanks:  cp .env.example .env
#
# Generate each secret below with:  openssl rand -base64 32
# Strapi will not start without APP_KEYS, and the admin panel will not issue a
# working session without ADMIN_JWT_SECRET.

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# Public origin, if it differs from HOST:PORT (a proxy, or a published Docker port).
# PUBLIC_URL=http://localhost:1337
# IS_PROXIED=false

# --- Secrets (required) ----------------------------------------------------
# Four comma-separated keys used to sign session cookies.
APP_KEYS=
ADMIN_JWT_SECRET=
# Optional: enables `strapi transfer` between instances.
TRANSFER_TOKEN_SALT=
API_TOKEN_SALT=
JWT_SECRET=
# Optional: enables `strapi transfer` between instances.
TRANSFER_TOKEN_SALT=

# --- Database --------------------------------------------------------------
# sqlite (default, zero setup) or postgres.
DATABASE_CLIENT=sqlite
# SQLite only. Relative paths resolve against the project root.
DATABASE_FILENAME=.tmp/data.db
# Postgres only.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=jomi_cms
# DATABASE_USERNAME=jomi
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10

# --- Seeding ---------------------------------------------------------------
# Builds the Home Page the challenge asks for, opens public read permissions and
# creates the first admin user. Idempotent, so it is safe to leave on locally.
SEED_ON_BOOTSTRAP=false
# SEED_ADMIN_EMAIL=admin@jomi.local
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FIRSTNAME=JOMI
# SEED_ADMIN_LASTNAME=Admin

# --- GraphQL ---------------------------------------------------------------
# GRAPHQL_DEPTH_LIMIT=12
# GRAPHQL_AMOUNT_LIMIT=100
# On outside production so the front-end's `yarn gen` can introspect the schema.
# GRAPHQL_INTROSPECTION=true

# --- HTTP ------------------------------------------------------------------
# Comma-separated allow-list of browser origins. Defaults to `*`.
# CORS_ORIGIN=http://localhost:3000
# Cache-Control applied to anonymous GET /api/* responses.
# HTTP_CACHE_ENABLED=true
# HTTP_CACHE_MAX_AGE=60
# HTTP_CACHE_SWR=600

# --- Media -----------------------------------------------------------------
# Any Strapi upload provider; `local` writes to public/uploads.
# UPLOAD_PROVIDER=local
# UPLOAD_PROVIDER_OPTIONS={}
# UPLOAD_SIZE_LIMIT=20971520
